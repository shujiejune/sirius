---
import { getCollection } from "astro:content";
import { calculateWordCount } from "../utils/wordCount";

const today = new Date();

// Total number of words written across all blog posts (computed at build time)
const posts = await getCollection("blog");
const totalWords = posts.reduce(
    (sum, post) => sum + calculateWordCount(post.body),
    0,
);
---

<footer class="py-8 px-4 border-t border-skin-line text-sm opacity-70">
    <div class="max-w-5xl mx-auto font-sans text-center">
        <span class="text-skin-accent">&copy; </span>
        2025-{today.getFullYear()} Jieniu has written{" "}
        {totalWords.toLocaleString("en-US")} words here.&nbsp; All rights
        reserved.
    </div>
</footer>
