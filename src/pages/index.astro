---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AuthorImageBack from "../assets/images/jieniu-back.svg?url";
import { SITE_DESCRIPTION, SITE_SIGNATURE, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="flex flex-col min-h-screen">
        <Header />
        <main class="flex flex-col grow justify-center items-center">
            <img
                src={AuthorImageBack}
                alt="My personal image: the back of Ze'Fang"
                width="450"
            />
            <slot />
        </main>
        <Footer />
    </body>
</html>
