---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const changelog: { date: string; content: string; link?: string }[] = [
    {
        date: "2026-09-13",
        content: "Migrated from GitHub Pages to CloudFlare Workers.",
    },
    {
        date: "2026-02-14",
        content:
            "Completed the features: Markdown support, Table of Contents, and Changelog.",
    },
    {
        date: "2026-02-10",
        content: "Replaced the Astropaper theme to my own one (Sirius).",
    },
    {
        date: "2025-01-04",
        content:
            "Launched this site with Astro, Vercel, and my domain name `jieniu.jetzt`.",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="About" description="About me and this site." />
    </head>
    <body class="flex flex-col">
        <Header />

        <main class="max-w-4xl mx-auto px-6 py-12 justify-start">
            <h2 class="font-sans text-4xl text-skin-accent-dark">About Me</h2>
            <div class="prose prose-slate mt-12 mb-12 pb-6 border-b border-skin-line">
                <p class="text-lg leading-relaxed text-skin-base">
                    I'm <span class="text-skin-accent">jieniu</span>.
                </p>
                <p class="text-lg leading-relaxed text-skin-base">
                    You can contact me via email:
                    <span class="pl-1 text-skin-accent">
                        jieniu.june[Shift+2]tutanota.com
                    </span>
                </p>
            </div>

            <h2 class="font-sans text-4xl text-skin-accent-dark">
                About This Site
            </h2>

            <div class="prose prose-slate mt-12 mb-12 pb-6 border-b border-skin-line">
                <p class="text-lg leading-relaxed text-skin-base">
                    I record my personal thinking and emotions here.
                </p>
                <p class="text-lg leading-relaxed text-skin-base">
                    All rights reserved. Unauthorized reproduction or
                    redistribution is strictly prohibited.
                </p>
            </div>

            <section>
                <h3 class="font-sans text-2xl text-skin-accent-dark mb-6 flex items-center gap-2">
                    Changelog
                </h3>

                <div class="relative border-l-2 border-slate-200 mt-12 ml-3 space-y-8">
                    {changelog.map((item) => (
                        <div class="relative pl-8">
                            <div class="absolute -left-2.25 top-1.5 h-4 w-4 rounded-full border-2 border-white bg-skin-fill shadow-sm" />

                            <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                                <span class="inline-block px-3 py-1 rounded-md text-xs font-mono font-semibold bg-blue-100 text-skin-accent shrink-0">
                                    {item.date}
                                </span>

                                <div class="text-skin-base">
                                    {item.link ? (
                                        <a
                                            href={item.link}
                                            class="hover:text-skin-accent hover:underline underline-offset-4 decoration-2 transition-colors"
                                        >
                                            {item.content}
                                        </a>
                                    ) : (
                                        <span>{item.content}</span>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </section>
        </main>

        <Footer />
    </body>
</html>
