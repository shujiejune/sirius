---
import BaseHead from "../components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import ProjectCard from "@components/ProjectCard.astro";
import type { Project } from "@objects/types";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main class="flex flex-col justify-content-center px-6 py-12 max-w-3xl mx-auto">
            <h1 class="text-4xl text-skin-accent-dark">Self Introduction</h1>
            <section id="projects">
                <h2 class="mb-6 text-2xl text-skin-accent-dark">
                    Featured Projects
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-12">
                    {projects.map((proj) => (
                        <ProjectCard project={proj} />
                    ))}
                </div>
            </section>
        </main>
        <Footer />
    </body>
</html>
