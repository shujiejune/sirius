---
import BaseHead from "../components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import ProjectCard from "@components/ProjectCard.astro";
import type { Project } from "@objects/types";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="flex flex-col min-h-screen">
        <div class="w-full">
            <Header />
        </div>

        <main class="grow w-full max-w-[92rem] mx-auto px-6 py-12 grid grid-cols-1 lg:grid-cols-[minmax(10rem,1fr)_min(48rem,100%)_minmax(10rem,1fr)] gap-12 lg:gap-x-24 items-start">
            <div class="w-full max-w-3xl lg:col-start-2 lg:row-start-1">
                <h2 class="font-sans text-4xl text-skin-accent-dark">Projects</h2>
                <section id="projects">
                    <div class="prose prose-slate mt-12 mb-12">
                        <p class="font-sans text-lg leading-relaxed text-skin-base">
                            Import my resume projects as placeholders.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {projects.map((proj) => (
                            <ProjectCard project={proj} />
                        ))}
                    </div>
                </section>
            </div>
        </main>

        <div class="w-full">
            <Footer />
        </div>
    </body>
</html>
